{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "{{landing}}",
  "preferredVersions": {
    "php": "8.2",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "WP_DEBUG": true,
        "WP_DEBUG_DISPLAY": true,
        "WP_DEBUG_LOG": true,
        "SCRIPT_DEBUG": true,
        "WP_ENVIRONMENT_TYPE": "local"
      }
    },
    {
      "step": "login",
      "username": "admin",
      "password": "password"
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "plugin-check"
      },
      "options": {
        "activate": true
      }
    },
{{#requires}}
    {
      "step": "wp-cli",
      "command": "wp plugin install --activate {{requires_args}}"
    },
{{/requires}}
    {
      "step": "activatePlugin",
      "pluginPath": "{{slug}}/{{slug}}.php"
    }
  ]
}
